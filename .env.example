# Copy this file to `.env` and adjust the values for your local setup.
# All variables are read in src/app_config/config.py

# --- Debug / logging ---
# Enables verbose (DEBUG level) console/file logging when truthy (true/1/yes)
DEBUG=true

# --- Paths ---
# Root of the repository (absolute path). Used to resolve output folders
# (e.g. latex_content/, results_RF/, results_LMEM/).
BASE_ROOT=/absolute/path/to/vcockpit-analytics

# Folder containing the raw per-session data (one subfolder per session,
# named <YYYYMMDD>_<HHMMSS>_<microseconds>), consumed by the integrity
# checker, the data ingester and the extractor. Defaults to ./data.
DATA=/absolute/path/to/vcockpit-analytics/data

# Folder containing the JSON session logs used by the DataIngester to
# discover which sessions are processable per scenario.
LOGS_JSON=/absolute/path/to/vcockpit-analytics/data/logs_json

# Optional: folder containing the raw study export, if different from DATA.
STUDY_FOLDER=/absolute/path/to/vcockpit-analytics/data/study

# Relative filename (within DATA) of the pickled Study object produced by
# the extraction step and consumed by the analysis scripts.
STUDY_PICKLE_FILE_PATH=study.pkl

# --- Metadata ---
# Scenario(s) to process. One of: city_calls_short, city_calls_long,
# highway_music_short, highway_music_long, or "all".
SCENARIO=all

# Comma-separated list (or identifier) of the participants/users to include.
USERS=all
